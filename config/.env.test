# Baseline config for the test environment, committed on purpose so that
# `npm run test:e2e` works on a fresh clone and in CI.
#
# MONGO_URI and REDIS_URI are deliberately absent: the e2e specs set them from
# the Testcontainers instances before importing the app module.

PORT=8080
JWT_SECRET=0xCAFEBABE
POW_DIFFICULTY=10
IDENT_SECRET=0xCAFEBABE
IDENT_EXPIRES_IN=300
USAGE_STATS_SECRET=0xCAFEBABE
TMP_DIR=./tmp
